---
const year = new Date().getFullYear();
---

<footer class="bg-slate-950 text-white border-t border-amber-400/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Column 1: School Identity -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-slate-900 border border-amber-400/50 flex items-center justify-center">
            <span class="text-amber-400 font-serif font-bold text-lg">G</span>
          </div>
          <div>
            <div class="font-serif font-bold text-sm uppercase tracking-wider text-white">Grace Christian</div>
            <div class="text-amber-400 text-[10px] tracking-[0.25em] uppercase font-semibold">High School · Gulu</div>
          </div>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          An institutional secondary boarding school dedicated to academic distinction, moral integrity, and regional leadership across Northern Uganda since 2003.
        </p>
        <div class="pt-2">
          <span class="inline-block px-3 py-1 bg-amber-400/10 border border-amber-400/30 text-amber-300 text-[11px] font-semibold uppercase tracking-wider">
            UNEB Examination Centre #1247-C
          </span>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-amber-400 mb-5 border-l-2 border-amber-400 pl-2">
          Quick Portals
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home Page</a></li>
          <li><a href="/about" class="hover:text-amber-400 transition-colors">About &amp; Heritage</a></li>
          <li><a href="/leadership" class="hover:text-amber-400 transition-colors">Board of Directors &amp; Faculty</a></li>
          <li><a href="/academics" class="hover:text-amber-400 transition-colors">Academic Programmes</a></li>
          <li><a href="/admissions" class="hover:text-amber-400 transition-colors">Admissions &amp; Fees</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Contact Administration</a></li>
        </ul>
      </div>

      <!-- Column 3: Academic Programmes -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-amber-400 mb-5 border-l-2 border-amber-400 pl-2">
          Curriculum
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li>Uganda Certificate of Education (UCE)</li>
          <li>A-Level Sciences (PCB, PCM, BCM, MEG)</li>
          <li>A-Level Arts &amp; Humanities (HEL, HGL, EGM)</li>
          <li>STEM Laboratory Practicals</li>
          <li>Regional Debate &amp; Parliamentary League</li>
        </ul>
      </div>

      <!-- Column 4: Contact & Location -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-amber-400 mb-5 border-l-2 border-amber-400 pl-2">
          Official Registry
        </h4>
        <address class="not-italic space-y-3 text-sm text-slate-400">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Acholi Road, P.O. Box 1247, Gulu City, Northern Uganda
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
            <a href="tel:+256784811929" class="hover:text-amber-400 transition-colors font-medium text-amber-300">+256 784 811 929</a>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@gracechristiangulu.ac.ug" class="hover:text-amber-400 transition-colors break-all">info@gracechristiangulu.ac.ug</a>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
            <a href="mailto:admissions@gracechristiangulu.ac.ug" class="hover:text-amber-400 transition-colors break-all">admissions@gracechristiangulu.ac.ug</a>
          </p>
        </address>
      </div>

    </div>

    <div class="mt-14 pt-8 border-t border-slate-900 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>&copy; {year} Grace Christian High School. All rights reserved.</p>
      <p>Licensed by Ministry of Education and Sports, Republic of Uganda</p>
        <p class="sm:basis-full text-[11px] text-slate-600 leading-relaxed">Photography: Wikimedia Commons &mdash; USAID, U.S. Navy, Joshua Olal Believer, Samson Ssemakadde, IICD (CC BY 2.0), SuSanA Secretariat (CC BY 2.0), Hustle champion (CC BY-SA 4.0).</p>
    </div>
  </div>
</footer>
