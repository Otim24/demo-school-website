---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/leadership', label: 'Board & Faculty' },
  { href: '/academics', label: 'Academics' },
  { href: '/admissions', label: 'Admissions' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- Top Administrative Utility Bar (Desktop & Tablet) -->
  <div id="top-bar" class="hidden md:block bg-slate-950 border-b border-white/10 text-white/80 text-xs py-2 px-4 sm:px-6 lg:px-8 transition-all duration-300">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 sm:gap-4">
      
      <div class="flex items-center gap-4 text-[11px] sm:text-xs">
        <span class="flex items-center gap-1.5 font-medium text-slate-300">
          <svg class="w-3.5 h-3.5 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Acholi Road, Gulu City, Northern Uganda
        </span>
        <span class="hidden md:inline text-white/20">|</span>
        <span class="hidden md:inline text-amber-300 font-semibold tracking-wider uppercase text-[11px]">
          UNEB Centre No. 1247-C
        </span>
      </div>

      <div class="flex items-center gap-4 text-[11px] sm:text-xs">
        <a href="tel:+256784811929" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 font-medium text-amber-300 py-1">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
          +256 784 811 929
        </a>
        <span class="text-white/20">|</span>
        <a href="mailto:info@gracechristiangulu.ac.ug" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 py-1 text-slate-300">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          info@gracechristiangulu.ac.ug
        </a>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div id="main-nav" class="bg-slate-950/95 backdrop-blur-md border-b border-white/10 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        
        <!-- School Crest & Identity -->
        <a href="/" class="flex items-center gap-3 group flex-shrink-0">
          <div class="w-9 h-9 sm:w-11 sm:h-11 bg-slate-900 border-2 border-amber-400/50 flex items-center justify-center shadow-lg group-hover:border-amber-400 transition-colors">
            <span class="text-amber-400 font-serif font-bold text-lg sm:text-xl tracking-tight">G</span>
          </div>
          <div class="leading-tight">
            <div class="text-white font-serif font-bold text-sm sm:text-base tracking-wide uppercase">Grace Christian</div>
            <div class="text-amber-400 text-[9px] sm:text-[10px] font-semibold tracking-[0.22em] sm:tracking-[0.25em] uppercase">High School · Gulu</div>
          </div>
        </a>

        <!-- Desktop Navigation Links with Eye-Catching Hover Effects -->
        <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`nav-link-item relative px-3.5 py-2 text-xs font-bold uppercase tracking-[0.14em] transition-all duration-300 group
                ${isCurrent(link.href)
                  ? 'text-amber-400 font-extrabold'
                  : 'text-white/80 hover:text-white'
                }`}
            >
              <!-- Hover Background Glow Pill -->
              <span class="absolute inset-0 bg-white/0 group-hover:bg-white/[0.06] border border-transparent group-hover:border-amber-400/30 transition-all duration-300"></span>
              
              <!-- Link Text -->
              <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-0.5">
                {link.label}
              </span>

              <!-- Active / Hover Underline -->
              <span class={`absolute bottom-0 left-2 right-2 h-0.5 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 transition-all duration-300
                ${isCurrent(link.href)
                  ? 'opacity-100 scale-x-100'
                  : 'opacity-0 scale-x-0 group-hover:opacity-100 group-hover:scale-x-100'}`}
              ></span>
            </a>
          ))}
        </nav>

        <!-- CTA & Mobile Trigger -->
        <div class="flex items-center gap-3 sm:gap-4">
          <a
            href="/admissions"
            class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold uppercase tracking-widest transition-all duration-200 shadow-md hover:shadow-lg active:scale-95"
          >
            Apply for 2025
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <!-- Mobile Phone Quick Button -->
          <a
            href="tel:+256784811929"
            class="lg:hidden p-2.5 bg-amber-500/10 border border-amber-400/40 text-amber-400 hover:bg-amber-500 hover:text-slate-950 transition-colors"
            aria-label="Call Admissions Directly"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
          </a>

          <!-- Mobile Hamburger Trigger -->
          <button
            id="mobile-btn"
            class="lg:hidden p-2 text-white hover:text-amber-400 transition-colors focus:outline-none"
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-open-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="menu-close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile & Tablet Full-Screen Navigation Drawer -->
  <div id="mobile-drawer" class="hidden lg:hidden bg-slate-950 border-b-2 border-amber-500 backdrop-blur-2xl shadow-2xl transition-all">
    <div class="px-6 py-6 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`flex items-center justify-between py-3.5 px-4 text-sm font-bold uppercase tracking-wider transition-colors border-l-2
            ${isCurrent(link.href)
              ? 'bg-amber-400/10 text-amber-400 border-amber-400'
              : 'text-slate-200 hover:text-white hover:bg-white/5 border-transparent'}`}
        >
          <span>{link.label}</span>
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ))}

      <!-- Mobile Direct Action Strip -->
      <div class="pt-4 mt-2 border-t border-white/10 space-y-3">
        <a
          href="/admissions"
          class="flex items-center justify-center gap-2 w-full py-4 bg-amber-500 active:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-widest shadow-md"
        >
          Apply for 2025 Admissions
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <a
            href="tel:+256784811929"
            class="flex items-center justify-center gap-1.5 py-3 border border-slate-700 bg-slate-900 text-amber-300 text-xs font-semibold"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
            Call Bureau
          </a>
          <a
            href="mailto:info@gracechristiangulu.ac.ug"
            class="flex items-center justify-center gap-1.5 py-3 border border-slate-700 bg-slate-900 text-slate-300 text-xs font-semibold"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Email Desk
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const mainNav = document.getElementById('main-nav');
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  function handleScroll() {
    if (window.scrollY > 30) {
      mainNav?.classList.add('bg-slate-950', 'shadow-2xl', 'border-amber-400/20');
    } else {
      mainNav?.classList.remove('shadow-2xl', 'border-amber-400/20');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  mobileBtn?.addEventListener('click', () => {
    const isClosed = mobileDrawer?.classList.contains('hidden');
    mobileDrawer?.classList.toggle('hidden', !isClosed);
    openIcon?.classList.toggle('hidden', isClosed);
    closeIcon?.classList.toggle('hidden', !isClosed);
  });
</script>
