---
import Layout from '../layouts/Layout.astro';

const boardOfGovernors = [
  {
    name: 'Rev. Dr. Samuel Okello, PhD',
    title: 'Chairman, Board of Governors',
    role: 'Founding visionary with 28 years directing Christian secondary education and human capital development across Acholiland.',
    image: 'https://images.unsplash.com/photo-1522529599102-193c0d76b5b6?auto=format&fit=crop&w=800&q=80',
  },
  {
    name: 'Justice Florence Lalam, LLM',
    title: 'Vice Chairperson & Legal Trustee',
    role: 'Appellate jurist guiding statutory compliance, institutional governance, child protection, and land development.',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80',
  },
  {
    name: 'Prof. Charles Odong, PhD',
    title: 'Academic Governance Trustee',
    role: 'Dean of Education at Gulu University, leading teacher vetting, curriculum benchmarking, and national exam standards.',
    image: 'https://images.unsplash.com/photo-1506277886164-e25aa3f4ef7f?auto=format&fit=crop&w=800&q=80',
  },
  {
    name: 'Mr. Moses Akena, CPA (U)',
    title: 'Financial Stewardship Trustee',
    role: 'Senior audit partner directing capital endowment funds, fee compliance, and bursary allocations for vulnerable scholars.',
    image: 'https://images.unsplash.com/photo-1507152832244-10d45c7eda57?auto=format&fit=crop&w=800&q=80',
  },
  {
    name: 'Dr. Grace Apiyo-Nyeko, MD',
    title: 'Health & Student Welfare Trustee',
    role: 'Consultant pediatrician at Lacor Hospital overseeing campus clinical infirmaries, nutrition, and adolescent health.',
    image: 'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?auto=format&fit=crop&w=800&q=80',
  },
  {
    name: 'Mrs. Eunice Atim, MEd',
    title: 'Ex-Officio Secretary & Headmistress',
    role: 'Chief executive officer presenting terminal academic audits, staffing oversight, and day-to-day boarding administration.',
    image: 'https://images.unsplash.com/photo-1567532939604-b6b5b0db2604?auto=format&fit=crop&w=800&q=80',
  },
];

const facultyHeads = [
  {
    name: 'Mrs. Eunice Atim, MEd',
    designation: 'Headmistress & Principal',
    department: 'Executive Administration',
    experience: '22 Years in Educational Leadership',
    image: 'https://images.unsplash.com/photo-1567532939604-b6b5b0db2604?auto=format&fit=crop&w=600&q=80',
  },
  {
    name: 'Mr. Patrick Ojok, BSc, PGDE',
    designation: 'Deputy Headmaster (Academics)',
    department: 'Physics & STEM Examination Registry',
    experience: '17 Years · Senior UNEB Examiner',
    image: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?auto=format&fit=crop&w=600&q=80',
  },
  {
    name: 'Mr. Walter Komakech, BA (Ed)',
    designation: 'Deputy Headmaster (Administration)',
    department: 'History & School Logistics',
    experience: '15 Years in School Operations',
    image: 'https://images.unsplash.com/photo-1506277886164-e25aa3f4ef7f?auto=format&fit=crop&w=600&q=80',
  },
  {
    name: 'Sr. Mary Lacor, DipEd',
    designation: 'Dean of Student Affairs',
    department: 'Pastoral Care, Guidance & Boarding',
    experience: '18 Years in Pastoral Counseling',
    image: 'https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=600&q=80',
  },
  {
    name: 'Mrs. Judith Acayo, MSc',
    designation: 'Head of Natural Sciences',
    department: 'Chemistry & Biology Complex',
    experience: '12 Years · Laboratory Supervisor',
    image: 'https://images.unsplash.com/photo-1589156280159-27698a70f29e?auto=format&fit=crop&w=600&q=80',
  },
  {
    name: 'Mr. Geoffrey Kilama, MA',
    designation: 'Head of Humanities & Debate',
    department: 'Economics & English Literature',
    experience: '14 Years · Regional Debate Patron',
    image: 'https://images.unsplash.com/photo-1507152832244-10d45c7eda57?auto=format&fit=crop&w=600&q=80',
  },
];
---

<Layout title="Board of Directors & Faculty" description="Governance, Board of Governors, and certified teaching faculty of Grace Christian High School in Gulu, Northern Uganda.">

  <!-- ════════════════════════════════════════
       PAGE HERO (CLEAR, VIBRANT AFRICAN LEADERSHIP BACKDROP)
  ════════════════════════════════════════ -->
  <section class="relative bg-slate-950 text-white pt-32 pb-20 sm:pt-36 sm:pb-24 overflow-hidden border-b border-amber-400/20">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=2000&q=85"
        alt="African institutional governance and academic leadership"
        class="w-full h-full object-cover object-center opacity-65"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/50"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="section-tag text-amber-400">Institutional Governance</div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight leading-tight mt-2 mb-4">
          Board of Directors &amp; <br/>
          <span class="text-amber-400">Academic Faculty</span>
        </h1>
        <p class="text-slate-200 text-sm sm:text-lg leading-relaxed font-normal">
          Governed by distinguished Ugandan civic, legal, and theological trustees, supported by an accomplished teaching faculty dedicated to raising principled scholars across Northern Uganda.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4 border-t border-white/20 pt-6">
        <div class="py-2 sm:pl-4 sm:border-l sm:border-white/20">
          <span class="text-amber-400 font-serif font-bold text-2xl sm:text-3xl block">1 : 15</span>
          <span class="text-white text-xs font-bold uppercase tracking-wider block mt-1">Teacher-Student Ratio</span>
        </div>
        <div class="py-2 sm:pl-4 sm:border-l sm:border-white/20">
          <span class="text-amber-400 font-serif font-bold text-2xl sm:text-3xl block">100%</span>
          <span class="text-white text-xs font-bold uppercase tracking-wider block mt-1">Certified Educators</span>
        </div>
        <div class="py-2 sm:pl-4 sm:border-l sm:border-white/20">
          <span class="text-amber-400 font-serif font-bold text-2xl sm:text-3xl block">65%</span>
          <span class="text-white text-xs font-bold uppercase tracking-wider block mt-1">Postgraduate Faculty</span>
        </div>
        <div class="py-2 sm:pl-4 sm:border-l sm:border-white/20">
          <span class="text-amber-400 font-serif font-bold text-2xl sm:text-3xl block">24/7</span>
          <span class="text-white text-xs font-bold uppercase tracking-wider block mt-1">Resident Mentors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       BOARD OF GOVERNORS (FEATURED CHAIR + EDITORIAL REGISTER)
  ════════════════════════════════════════ -->
  <section class="py-20 sm:py-28 bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="reveal max-w-2xl mb-12 sm:mb-16">
        <div class="section-tag">Fiduciary &amp; Spiritual Oversight</div>
        <h2 class="text-3xl sm:text-5xl font-serif font-bold text-slate-900 mt-2">The Board of Governors</h2>
        <p class="text-slate-600 text-sm sm:text-base mt-3">Eminent African leaders providing strategic vision, legal guardianship, and moral accountability.</p>
      </div>

      <!-- Featured: Chairman -->
      <article class="reveal grid md:grid-cols-12 bg-slate-950 text-white overflow-hidden mb-14 sm:mb-20">
        <div class="md:col-span-5 h-80 md:h-auto">
          <img src={boardOfGovernors[0].image} alt={boardOfGovernors[0].name} class="w-full h-full object-cover object-top" />
        </div>
        <div class="md:col-span-7 p-8 sm:p-12 flex flex-col justify-center">
          <span class="text-amber-400 text-[11px] font-bold uppercase tracking-[0.25em]">{boardOfGovernors[0].title}</span>
          <h3 class="font-serif font-bold text-2xl sm:text-4xl text-white mt-3 leading-tight">{boardOfGovernors[0].name}</h3>
          <div class="w-12 h-0.5 bg-amber-400 my-6"></div>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">{boardOfGovernors[0].role}</p>
        </div>
      </article>

      <!-- Remaining Governors: ruled directory -->
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <div class="section-tag">Trustees</div>
            <h3 class="font-serif font-bold text-2xl text-slate-900 mt-2">Governing Trustees</h3>
            <p class="text-slate-500 text-sm mt-3 leading-relaxed">Each trustee chairs a standing committee reporting to the full Board every term.</p>
          </div>
        </div>
        <ul class="lg:col-span-8 divide-y divide-slate-200 border-y border-slate-200">
          {boardOfGovernors.slice(1).map((m, i) => (
            <li class="reveal group flex gap-4 sm:gap-6 py-6 hover:bg-white transition-colors px-2 sm:px-4 border-l-2 border-transparent hover:border-amber-500">
              <img src={m.image} alt={m.name} class="w-16 h-16 sm:w-24 sm:h-24 object-cover object-top flex-shrink-0 bg-slate-200" loading="lazy" />
              <div class="min-w-0">
                <span class="text-slate-400 text-[11px] font-bold tracking-widest">{String(i + 2).padStart(2, '0')}</span>
                <h4 class="font-serif font-bold text-lg sm:text-xl text-slate-900 leading-snug">{m.name}</h4>
                <span class="text-amber-700 text-[11px] font-bold uppercase tracking-wider block mt-0.5">{m.title}</span>
                <p class="text-slate-600 text-sm leading-relaxed mt-2 hidden sm:block">{m.role}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════
       VIBRANT FULL-BLEED EDUCATOR PHOTOGRAPHY BANNER
  ════════════════════════════════════════ -->
  <section class="relative py-20 bg-slate-950 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=2000&q=85"
        alt="African teacher instructing students in classroom"
        class="w-full h-full object-cover object-center opacity-55"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl space-y-4">
        <div class="section-tag text-amber-400">Resident Teaching Community</div>
        <h2 class="text-2xl sm:text-4xl font-serif font-bold text-white leading-tight">
          Educators Who Reside on Campus, Inspiring Excellence Round the Clock
        </h2>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
          Over 70% of our teaching staff live directly on the Acholi Road campus. This ensures supervised evening study halls, immediate academic assistance, and strong moral guardianship for every boarder.
        </p>
        <div class="pt-4 flex flex-wrap gap-4">
          <a href="/admissions" class="btn-gold">
            Enroll for 2025
          </a>
          <a href="tel:+256784811929" class="btn-outline-white flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
            Telephone the Principal
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       ACADEMIC DEPARTMENTAL HEADS (REGISTER LAYOUT)
  ════════════════════════════════════════ -->
  <section class="py-20 sm:py-28 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-6 border-b-2 border-slate-900">
        <div>
          <div class="section-tag">Instructional Leadership</div>
          <h2 class="text-2xl sm:text-4xl font-serif font-bold text-slate-900 mt-2">Academic Departmental Heads</h2>
        </div>
        <p class="text-slate-500 text-sm max-w-sm">Certified subject specialists directing our UNEB O-Level and A-Level curricula.</p>
      </div>

      <!-- Column labels (tablet and up) -->
      <div class="hidden md:grid grid-cols-12 gap-6 px-4 pb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">
        <div class="col-span-5">Name &amp; Office</div>
        <div class="col-span-4">Department</div>
        <div class="col-span-3">Experience</div>
      </div>

      <ul class="divide-y divide-slate-200 border-t border-slate-200">
        {facultyHeads.map((f) => (
          <li class="reveal group grid grid-cols-12 gap-x-4 md:gap-x-6 gap-y-1 items-center px-3 sm:px-4 py-4 sm:py-5 hover:bg-slate-50 transition-colors border-l-2 border-transparent hover:border-amber-500">
            <div class="col-span-12 md:col-span-5 flex items-center gap-4">
              <img src={f.image} alt={f.name} class="w-14 h-14 sm:w-16 sm:h-16 object-cover object-top flex-shrink-0 bg-slate-200" loading="lazy" />
              <div class="min-w-0">
                <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 leading-snug">{f.name}</h3>
                <span class="text-amber-700 text-[11px] font-bold uppercase tracking-wider block mt-0.5">{f.designation}</span>
              </div>
            </div>
            <div class="col-span-12 md:col-span-4 text-sm text-slate-600 pl-[4.5rem] sm:pl-20 md:pl-0">{f.department}</div>
            <div class="col-span-12 md:col-span-3 text-xs text-slate-500 pl-[4.5rem] sm:pl-20 md:pl-0">{f.experience}</div>
          </li>
        ))}
      </ul>

      <div class="reveal mt-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-l-4 border-amber-500 bg-slate-50 px-6 py-5">
        <div>
          <span class="text-slate-900 font-serif font-bold text-base block">Questions regarding curriculum placement or staffing?</span>
          <span class="text-slate-500 text-xs">Reach out to the Deputy Headmaster (Academics) or Academic Secretariat.</span>
        </div>
        <a href="mailto:info@gracechristiangulu.ac.ug" class="btn-navy py-3 text-xs whitespace-nowrap">Email Academic Secretariat</a>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════
       CTA BANNER (AFRICAN GRADUATION BACKDROP)
  ════════════════════════════════════════ -->
  <section class="relative py-24 bg-slate-950 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=2000&q=85"
        alt="African secondary scholars celebrating graduation"
        class="w-full h-full object-cover opacity-60"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/60"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <div class="section-tag text-amber-400 justify-center mb-3">Principled Mentorship</div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-4">
        Entrust Your Child's Secondary Education to Seasoned Mentors
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-8">
        Learn how our resident educators and distinguished Board guide each student toward top-tier UNEB results and godly character.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/admissions" class="btn-gold py-3.5 px-8 text-xs font-bold uppercase tracking-widest">
          Apply for 2025 Admissions
        </a>
        <a href="tel:+256784811929" class="btn-outline-white py-3.5 px-6 text-xs font-bold uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
          Call Admissions (+256 784 811 929)
        </a>
      </div>
    </div>
  </section>

</Layout>
